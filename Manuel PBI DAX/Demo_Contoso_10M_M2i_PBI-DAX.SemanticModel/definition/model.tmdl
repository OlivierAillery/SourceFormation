model Model
	culture: fr-FR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: fr-FR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

/// Paramètres des requêtes (serveur, base de données...)
queryGroup PARAMETRES

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DimClients","pAnneeHistorique","pServer","pBaseDeDonnees","DimMagasins","DimProduits","FactVENTES","Produits Non Vendu","Clients dans Ventes mais pas Client"]

annotation PBI_ProTooling = ["TMDLView_Desktop","DevMode","DaxQueryView_Desktop"]

ref table DimClients
ref table DimMagasins
ref table DimProduits
ref table FactVENTES
ref table DimDates
ref table 'MESURES DAX'

ref cultureInfo fr-FR

