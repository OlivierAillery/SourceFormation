model Model
	culture: fr-FR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: fr-FR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

/// Paramètres des requêtes (serveur, base de données...)
queryGroup PARAMETRES

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DimClients","pServer","pBaseDeDonnees","DimMagasins","DimProduits","FactVENTES"]

annotation PBI_ProTooling = ["TMDLView_Desktop","DevMode"]

ref table DimClients
ref table DimMagasins
ref table DimProduits
ref table FactVENTES
ref table DimDates
ref table 'CALCULS et MESURES'

ref cultureInfo fr-FR

