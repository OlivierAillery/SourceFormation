	column Remise
		dataType: decimal
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: 60ec4a0d-283f-46e1-85a2-839e5d5c5278
		summarizeBy: sum
