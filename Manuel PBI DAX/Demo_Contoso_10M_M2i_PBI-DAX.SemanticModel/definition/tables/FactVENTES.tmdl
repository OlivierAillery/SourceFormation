		annotation PBI_FormatHint = {"currencyCulture":"fr-FR"}

	partition FactVENTES = m
		mode: import
		source =
				let
				    Source = Sql.Database(pServer, pBaseDeDonnees, [Query="SELECT tabA.[OrderKey]#(lf)      ,tabA.[CustomerKey]#(lf)      ,tabA.[StoreKey]#(lf)      ,TRY_CAST(tabA.[OrderDate] AS Date) AS OrderDate#(lf)      ,TRY_CAST(tabA.[DeliveryDate] AS Date) AS DeliveryDate#(lf)      --,tabA.[CurrencyCode]#(lf)      --,tabB.[Exchange]#(lf)      ,tabC.[ProductKey]#(lf)      ,tabC.[Quantity]#(lf)      --,tabC.[UnitPrice]#(lf)      --,tabC.[NetPrice]#(lf)      --,tabC.[UnitCost]#(lf)      ,tabC.[UnitCost]*tabB.[Exchange] AS UnitCostEUR#(lf)      ,tabC.[NetPrice]*tabB.[Exchange] AS NetPriceEUR#(lf)      ,tabC.[UnitPrice]*tabB.[Exchange] AS UnitPriceEUR#(lf)  FROM [Contoso_10M].[dbo].[Orders] AS tabA#(lf)  --Jointure avec la table de change pour récupérer le taux de change à la date de la commande#(lf)  INNER JOIN CurrencyExchange AS TabB #(lf)  ON  tabA.[CurrencyCode]=tabB.FromCurrency COLLATE French_CI_AS#(lf)  AND tabA.OrderDate = tabB.Date#(lf)  AND tabB.ToCurrency = 'EUR' --On ne garde que la conversion vers euro#(lf)    --Jointure externe gauche pour récupérer les lignes de commande#(lf)  LEFT OUTER JOIN [Contoso_10M].[dbo].[OrderRows] AS tabC#(lf)    ON tabA.[OrderKey] = tabC.[OrderKey]", CreateNavigationProperties=false]),
				    #"Colonnes renommées" = Table.RenameColumns(Source,{{"OrderKey", "IDFacture"}, {"CustomerKey", "IDClient"}, {"StoreKey", "IDMagasin"}, {"OrderDate", "DateVente"}, {"DeliveryDate", "DateLivraison"}, {"ProductKey", "IDProduit"}, {"Quantity", "Quantité"}}),
				    #"Soustraction insérée" = Table.AddColumn(#"Colonnes renommées", "Soustraction", each [UnitPriceEUR] - [NetPriceEUR], type number),
				    #"Colonnes renommées1" = Table.RenameColumns(#"Soustraction insérée",{{"Soustraction", "Remise"}}),
				    #"Type modifié" = Table.TransformColumnTypes(#"Colonnes renommées1",{{"UnitCostEUR", Currency.Type}, {"NetPriceEUR", Currency.Type}, {"UnitPriceEUR", Currency.Type}, {"Remise", Currency.Type}})
				in
				    #"Type modifié"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

